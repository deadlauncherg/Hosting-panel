<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chunk Host Portal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700&family=Rajdhani:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Rajdhani', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            position: relative;
        }

        body::before {
            content: "";
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-image: url('https://raw.githubusercontent.com/deadlauncherg/PUFFER-PANEL-IN-FIREBASE/6f54b98eef887707941bcbad542d91f493c3dc18/f563e69bc655c58937afed34c3409cbfb526565b.jpeg');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            filter: brightness(0.6);
            z-index: -2;
        }

        body::after {
            content: "";
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(10, 14, 23, 0.7);
            backdrop-filter: blur(3px);
            z-index: -1;
        }

        .login-container {
            width: 100%;
            max-width: 450px;
        }

        .login-card {
            background: rgba(19, 26, 44, 0.85);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(0, 163, 255, 0.3);
            border-radius: 24px;
            padding: 40px;
            box-shadow: 0 25px 45px rgba(0, 0, 0, 0.4);
            transition: transform 0.3s ease;
        }

        .login-card:hover {
            transform: translateY(-5px);
        }

        .header {
            text-align: center;
            margin-bottom: 30px;
        }

        .logo {
            width: 80px;
            height: 80px;
            margin: 0 auto 15px;
            background: linear-gradient(145deg, #131a2c, #0a0e17);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 10px rgba(0, 163, 255, 0.7);
            border: 1px solid #00a3ff;
        }

        .logo i {
            font-size: 32px;
            color: #00a3ff;
        }

        .title {
            font-family: 'Orbitron', sans-serif;
            font-size: 28px;
            font-weight: 700;
            letter-spacing: 1px;
            background: linear-gradient(to right, #ffffff, #00a3ff);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        .subtitle {
            color: #a0aec0;
            font-size: 14px;
            margin-top: 5px;
        }

        .welcome-text {
            text-align: center;
            margin-bottom: 20px;
            color: #a0aec0;
            font-weight: 500;
        }

        .verify-section {
            background: rgba(0, 0, 0, 0.4);
            border-radius: 12px;
            padding: 14px 16px;
            margin: 20px 0;
            border: 1px solid rgba(0, 163, 255, 0.3);
            transition: all 0.2s;
        }

        .verify-label {
            display: flex;
            align-items: center;
            gap: 12px;
            cursor: pointer;
        }

        .verify-label input {
            width: 18px;
            height: 18px;
            cursor: pointer;
            accent-color: #00a3ff;
        }

        .verify-text {
            font-weight: 500;
            font-size: 15px;
            color: #e2e8f0;
        }

        .verify-text i {
            color: #00a3ff;
            margin-right: 6px;
        }

        .verify-status {
            margin-top: 10px;
            font-size: 12px;
            color: #94a3b8;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .login-button {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, #00a3ff 0%, #0062cc 100%);
            color: white;
            border: none;
            border-radius: 12px;
            font-family: 'Orbitron', sans-serif;
            font-size: 14px;
            font-weight: 600;
            letter-spacing: 1px;
            cursor: pointer;
            transition: all 0.3s;
            text-decoration: none;
        }

        .login-button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .login-button:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0, 163, 255, 0.5);
        }

        .login-button i {
            margin-right: 10px;
            font-size: 18px;
        }

        .footer {
            text-align: center;
            margin-top: 30px;
            color: #a0aec0;
            font-size: 12px;
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-card">
            <div class="header">
                <div class="logo">
                    <i class="fas fa-server"></i>
                </div>
                <h1 class="title">CHUNK HOST</h1>
                <p class="subtitle">Next-Generation Server Solutions</p>
            </div>

            <p class="welcome-text">Access your ChunkHost dashboard</p>

            <div class="verify-section" id="verifySection">
                <label class="verify-label">
                    <input type="checkbox" id="humanCheckbox">
                    <span class="verify-text">
                        <i class="fas fa-shield-alt"></i> Verify you are human
                    </span>
                </label>
                <div class="verify-status" id="verifyStatus">
                    <i class="fas fa-info-circle"></i>
                    <span>Click the checkbox to confirm you're human</span>
                </div>
            </div>

            <a href="../login" class="login-button" id="discordBtn">
                <i class="fab fa-discord"></i>
                SIGN IN WITH DISCORD
            </a>

            <div class="footer">
                <p>© 2024 ChunkHost Hosting. All systems operational.</p>
            </div>
        </div>
    </div>

    <script>
        const checkbox = document.getElementById('humanCheckbox');
        const button = document.getElementById('discordBtn');
        const verifyStatus = document.getElementById('verifyStatus');
        const verifySection = document.getElementById('verifySection');

        checkbox.addEventListener('change', function() {
            if (this.checked) {
                button.disabled = false;
                verifyStatus.innerHTML = '<i class="fas fa-check-circle" style="color:#2ecc71;"></i> <span style="color:#2ecc71;">Verified — You are human. Proceed to login.</span>';
                verifySection.style.borderColor = '#2ecc71';
                verifySection.style.background = 'rgba(46, 204, 113, 0.1)';
            } else {
                button.disabled = true;
                verifyStatus.innerHTML = '<i class="fas fa-info-circle"></i> <span>Click the checkbox to confirm you\'re human</span>';
                verifySection.style.borderColor = 'rgba(0, 163, 255, 0.3)';
                verifySection.style.background = 'rgba(0, 0, 0, 0.4)';
            }
        });

        button.disabled = true;

        button.addEventListener('click', function(e) {
            if (button.disabled) {
                e.preventDefault();
                verifyStatus.innerHTML = '<i class="fas fa-exclamation-triangle" style="color:#ffaa33;"></i> <span style="color:#ffaa33;">Please verify you are human first!</span>';
                setTimeout(() => {
                    if (!checkbox.checked) {
                        verifyStatus.innerHTML = '<i class="fas fa-info-circle"></i> <span>Click the checkbox to confirm you\'re human</span>';
                    }
                }, 2000);
            }
        });
    </script>
</body>
</html>
