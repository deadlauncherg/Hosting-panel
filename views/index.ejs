<body>

    <!-- Dark overlay for better text contrast -->
    <div class="bg-overlay"></div>
    <div class="grid-overlay"></div>

    <!-- Login Container -->
    <div class="login-container">
        <div class="login-card">
            <div class="card-content">
                <div class="header">
                    <div class="logo">
                        <i class="fas fa-server"></i>
                    </div>
                    <h1 class="title">CHUNK HOST</h1>
                    <p class="subtitle">Next-Generation Server Solutions</p>
                </div>

                <p class="welcome-text" style="text-align: center; margin-bottom: 15px; color: var(--text-secondary); font-weight: 500;">
                    Access your ChunkHost dashboard
                </p>

                <!-- SIMPLE HUMAN VERIFICATION (Checkbox style) -->
                <div class="verify-section" id="verifySection">
                    <label class="verify-label" id="verifyCheckboxLabel">
                        <input type="checkbox" id="humanCheckbox">
                        <span class="verify-text">
                            <i class="fas fa-shield-alt verify-icon"></i> 
                            Verify you are human
                        </span>
                    </label>
                    <div class="verify-status" id="verifyStatusMsg">
                        <i class="fas fa-info-circle"></i>
                        <span class="status-badge">Click to confirm you're human (simple verification)</span>
                    </div>
                </div>

                <!-- Discord Login button (disabled until verified) -->
                <a href="../login" class="login-button" id="discordLoginBtn">
                    <i class="fab fa-discord"></i>
                    SIGN IN WITH DISCORD
                </a>

                <div class="footer">
                    <p>© 2024 ChunkHost Hosting. All systems operational.</p>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // ---------- SIMPLE HUMAN VERIFICATION LOGIC ----------
            const humanCheckbox = document.getElementById('humanCheckbox');
            const discordBtn = document.getElementById('discordLoginBtn');
            const verifyStatusSpan = document.querySelector('#verifyStatusMsg .status-badge');
            
            // Function to update button state based on checkbox
            function updateVerificationState() {
                if (humanCheckbox.checked) {
                    discordBtn.disabled = false;
                    if (verifyStatusSpan) {
                        verifyStatusSpan.innerHTML = '<i class="fas fa-check-circle" style="color:#00ff9d;"></i> Verified — You are human. Proceed to login.';
                        verifyStatusSpan.style.color = "#b8f2d0";
                    }
                    // Change the verify section style to indicate success
                    const verifyDiv = document.getElementById('verifySection');
                    if (verifyDiv) {
                        verifyDiv.style.borderColor = "#2ecc71";
                        verifyDiv.style.backgroundColor = "rgba(46, 204, 113, 0.1)";
                    }
                } else {
                    discordBtn.disabled = true;
                    if (verifyStatusSpan) {
                        verifyStatusSpan.innerHTML = 'Click the checkbox to confirm you\'re human (simple verification).';
                        verifyStatusSpan.style.color = "#a0aec0";
                    }
                    const verifyDiv = document.getElementById('verifySection');
                    if (verifyDiv) {
                        verifyDiv.style.borderColor = "rgba(0, 163, 255, 0.25)";
                        verifyDiv.style.backgroundColor = "rgba(0, 0, 0, 0.35)";
                    }
                }
            }
            
            // Attach event listener to checkbox
            if (humanCheckbox) {
                humanCheckbox.addEventListener('change', updateVerificationState);
                // Initialize button state (disabled by default)
                discordBtn.disabled = true;
            }
            
            // Optional: Add a small animation when checkbox is checked
            humanCheckbox.addEventListener('change', function(e) {
                if (this.checked) {
                    // Simple UI feedback
                    const verifyDiv = document.getElementById('verifySection');
                    if (verifyDiv) {
                        verifyDiv.style.transform = "scale(0.99)";
                        setTimeout(() => { if(verifyDiv) verifyDiv.style.transform = ""; }, 150);
                    }
                }
            });
            
            // ---------- PREVENT CLICK ON DISABLED BUTTON (just in case) ----------
            discordBtn.addEventListener('click', function(e) {
                if (discordBtn.disabled) {
                    e.preventDefault();
                    // visual feedback
                    const msgDiv = document.getElementById('verifyStatusMsg');
                    if (msgDiv) {
                        const originalText = msgDiv.innerHTML;
                        msgDiv.innerHTML = '<i class="fas fa-exclamation-triangle" style="color:#ffaa33;"></i> <span style="color:#ffaa33;">Please verify you are human first!</span>';
                        setTimeout(() => {
                            if (msgDiv) msgDiv.innerHTML = originalText;
                        }, 2000);
                    }
                    return false;
                }
                // if enabled, just allow the href redirect
                return true;
            });
            
            // ---------- BACKGROUND ASSETS / Remove old particle network to keep new background clean ----------
            // (No canvas needed, we use the raw background image from GitHub)
            // Also ensure any leftover particle-network div is gone (original removed)
            // We'll also add a dynamic tilt effect on the card (premium feel)
            const card = document.querySelector('.login-card');
            if (card) {
                card.addEventListener('mousemove', (e) => {
                    const x = e.clientX - card.getBoundingClientRect().left;
                    const y = e.clientY - card.getBoundingClientRect().top;
                    const centerX = card.offsetWidth / 2;
                    const centerY = card.offsetHeight / 2;
                    const rotateX = (y - centerY) / 25;
                    const rotateY = (centerX - x) / 25;
                    card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
                });
                card.addEventListener('mouseleave', () => {
                    card.style.transform = 'perspective(1000px) rotateX(0) rotateY(0)';
                });
            }
            
            // Optional: small console confirmation
            console.log("ChunkHost | Simple human verification added + background image updated (GitHub raw).");
        });
    </script>
</body>
</html>
